{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spike-tauri-launcher",
  "version": "0.0.0",
  "identifier": "com.cyberneura.flintkey.spike",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Flintkey spike (Tauri)",
        "width": 720,
        "height": 480,
        "center": true,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
